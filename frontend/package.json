{
  "name": "map-your-heroine",
  "scripts": {
    "ng": "ng",
    "start": "yarn serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "build:en": "ng build --configuration=production-en",
    "i18n": "ng xi18n --output-path locale",
    "serve": "ng serve --proxy-config ../proxy.conf.json --disable-host-check",
    "serve:en": "ng serve --proxy-config ../proxy.conf.json --configuration=en",
    "stop": "lsof -t -i tcp:4200 | xargs kill -9 || echo \"not running\"",
    "test-once": "ng test --watch=false",
    "watch": "ng build --configuration production --watch"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.14",
    "@angular/cdk": "^17.3.10",
    "@angular/common": "^18.2.14",
    "@angular/compiler": "^18.2.14",
    "@angular/core": "^18.2.14",
    "@angular/forms": "^18.2.14",
    "@angular/localize": "^18.2.14",
    "@angular/platform-browser": "^18.2.14",
    "@angular/platform-browser-dynamic": "^18.2.14",
    "@angular/router": "^18.2.14",
    "@creativebulma/bulma-divider": "^1.1.0",
    "@fortawesome/angular-fontawesome": "~0.15.0",
    "@fortawesome/fontawesome-svg-core": "^1.2.24",
    "@fortawesome/free-solid-svg-icons": "^5.11.1",
    "@primeng/themes": "~18.0",
    "bulma": "^0.7.5",
    "chart.js": "^3.9.1",
    "file-saver": "^2.0.5",
    "primeng": "~18.0.2",
    "rxjs": "^7.8.1",
    "survey-angular-ui": "^2.5.14",
    "survey-core": "^2.5.14",
    "tslib": "^2.0.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.14",
    "@angular/language-service": "^18.2.14",
    "@types/file-saver": "^2.0.1",
    "@types/jasmine": "^3.8.0",
    "@types/jasminewd2": "~2.0.3",
    "jasmine-core": "^3.8.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.3.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "protractor": "~7.0.0",
    "ts-node": "~7.0.0",
    "typescript": "~5.5.4"
  }
}
