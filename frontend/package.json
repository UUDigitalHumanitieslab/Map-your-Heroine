{
  "name": "map-your-heroine",
  "scripts": {
    "ng": "ng",
    "start": "yarn serve",
    "build": "ng build --base-href=/static/",
    "test": "ng test",
    "lint": "ng lint",
    "i18n": "ng xi18n --output-path locale",
    "serve": "ng serve --proxy-config ../proxy.conf.json",
    "stop": "lsof -t -i tcp:4200 | xargs kill -9 || echo \"not running\"",
    "test-once": "ng test --watch=false",
    "watch": "ng build --configuration production --watch"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.17",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.17",
    "@angular/compiler": "^20.3.18",
    "@angular/core": "^20.3.25",
    "@angular/forms": "^20.3.17",
    "@angular/localize": "^20.3.17",
    "@angular/platform-browser": "^20.3.17",
    "@angular/platform-browser-dynamic": "^20.3.17",
    "@angular/router": "^20.3.17",
    "@creativebulma/bulma-divider": "^1.1.0",
    "@fortawesome/angular-fontawesome": "~2.0.1",
    "@fortawesome/fontawesome-svg-core": "^1.2.24",
    "@fortawesome/free-solid-svg-icons": "^5.11.1",
    "@primeng/themes": "^20.4.0",
    "bulma": "^0.7.5",
    "chart.js": "^3.9.1",
    "file-saver": "^2.0.5",
    "primeng": "~20.4.0",
    "rxjs": "^7.8.1",
    "survey-angular-ui": "^2.5.14",
    "survey-core": "^2.5.14",
    "tslib": "^2.0.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.19",
    "@angular/cli": "^20.3.19",
    "@angular/compiler-cli": "^20.3.17",
    "@angular/language-service": "^20.3.17",
    "@types/file-saver": "^2.0.1",
    "@types/jasmine": "^3.8.0",
    "@types/jasminewd2": "~2.0.3",
    "jasmine-core": "^3.8.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.3.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "ts-node": "~7.0.0",
    "typescript": "~5.9.3"
  }
}
